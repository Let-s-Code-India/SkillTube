{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skilltube",
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/skill/*",
      "/dev/*",
      "/developers",
      "/developers/*",
      "/sitemap.xml",
      "/sitemap-*",
      "/robots.txt",
      "/llms.txt",
      "/topic/*",
      "/leaderboard",
      "/leaderboard/",
      "/badges",
      "/badges/"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://tdxzcpigazlzzbyoccwo.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_19_NEAah3imqX5-NnWde2w_NoNz_6bK",
    "SITE_URL": "https://skilltube.ayushgiri-ai-21.workers.dev"
  }
}
