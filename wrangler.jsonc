{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skilltube",
  "main": "worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/skill/*",
      "/dev/*",
      "/developers",
      "/developers/*",
      "/sitemap.xml",
      "/sitemap-*",
      "/robots.txt",
      "/llms.txt"
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://tdxzcpigazlzzbyoccwo.supabase.co",
    "SUPABASE_ANON_KEY": "PASTE_YOUR_ANON_OR_PUBLISHABLE_KEY_HERE",
    "SITE_URL": "https://skilltube-ayushgiri-ai-21.workers.dev"
  }
}
